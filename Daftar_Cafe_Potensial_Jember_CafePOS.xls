   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">9</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Tanaloka Eatery &amp; Coffee</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Sumbersari (Kalimantan)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Jl. Kalimantan No.68, Krajan Timur, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 812-3436-7890</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">10.00 – 23.00 WIB</Data></Cell>
