   <Row ss:AutoFitHeight="0" ss:Height="27.9375">
    <Cell ss:StyleID="s62"><Data ss:Type="String">No</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Nama Kafe / Coffee Shop</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Kawasan / Area</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Alamat Lengkap</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Nomor Telepon / WA</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Jam Operasional</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Tipe Tempat &amp; Konsep</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Kapasitas Tempat</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Tingkat Prioritas Lead</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Fitur CafePOS Paling Dibutuhkan</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Analisis Masalah &amp; Peluang Prospek</Data></Cell>
    <Cell ss:StyleID="s62"><Data ss:Type="String">Tautan Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Grand Cafe Jember</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Sumbersari (Kampus UNEJ)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Jl. Jawa No.28A Lt. 2-3, Tegal Boto Lor, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 821-1633-4779</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">10.00 – 24.00 WIB</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Rooftop &amp; Indoor Modern Cafe (2 Lantai)</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Besar (150+ orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">QR Table Ordering 2 Lantai, Kitchen Display (KDS), Multi-printer (Bar &amp; Kitchen)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Area 2 lantai menyulitkan pelayan bolak-balik. Tamu di lantai 3 sering terlambat dilayani. QR order langsung potong komplain tamu.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Grand+Cafe+Jember+Jl+Jawa"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s69"><Data ss:Type="Number">2</Data></Cell>
    <Cell ss:StyleID="s70"><Data ss:Type="String">Senja Coffee &amp; Kitchen</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Patrang (Gebang)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Jl. Merak No.789, Gebang Krajan, Gebang, Patrang, Jember 68117</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">+62 822-4538-0005</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">10.00 – 23.00 WIB</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Aesthetic Garden &amp; Semi-Outdoor Resto</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">Besar (120+ orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">QR Meja Outdoor Gazebo, Payment Gateway QRIS, Split Bill</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Area taman outdoor luas, kasir di depan. Pelayan sering tidak melihat tamu yang mau order tambahan camilan/minuman.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Senja+Coffee+Kitchen+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">3</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Perasa Coffee &amp; Eatery (24 Jam)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Sumbersari (Kampus)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Jl. Sumatra No.128, Tegal Boto Lor, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 853-6656-7799</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Buka 24 Jam</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">24/7 Co-working &amp; Coffee Space Mahasiswa</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Sedang-Besar (80-100 orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Shift Kasir 24 Jam, QR Self-Ordering Meja, Realtime Stock</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Shift malam minim kasir. Mahasiswa yang nugas malam bisa pesan makanan langsung lewat QR tanpa antre di bar kasir.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Perasa+Coffee+Eatery+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s69"><Data ss:Type="Number">4</Data></Cell>
    <Cell ss:StyleID="s70"><Data ss:Type="String">Bento Kopi Jember</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Sumbersari (Antirogo)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Jl. Tawangmangu, Antirogo, Sumbersari, Jember 68125</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">+62 823-3489-2237</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">09.00 – 01.00 WIB</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Large Open Space &amp; Komunitas Cafe</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">Sangat Besar (200+ orang, 100+ meja)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">QR Table Ordering Skala Besar, Kitchen Display, Monitor Antrean</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Jumlah meja ratusan. Pelayan manual sering salah antar meja dan lama mencatat. QR ordering otomatis menurunkan beban staf 60%.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Bento+Kopi+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">5</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Kafe Kolong Jember</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Sumbersari (Mastrip)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Bawah Jembatan Jarwo, Jl. Mastrip, Krajan Timur, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 811-3446-313</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">18.00 – 01.00 WIB</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Heritage / Underground Riverbank Cafe Unik</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Besar (100+ orang)</Data></Cell>
    <Cell ss:StyleID="s72"><Data ss:Type="String">Prioritas Tinggi</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">QR Meja Cepat, Laporan Penjualan Real-time, Offline-first</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Tempat ikonik di kolong jembatan dengan tata letak memanjang. Mobilitas kasir terbatas, QR ordering sangat memudahkan pengunjung.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Kafe+Kolong+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s69"><Data ss:Type="Number">6</Data></Cell>
    <Cell ss:StyleID="s70"><Data ss:Type="String">Kafe Tebing (Taman Botani Sukorambi)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Sukorambi (Wisata)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Kompleks Wisata Taman Botani, Jl. Mujahir, Sukorambi, Jember 68151</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">+62 811-3003-6000 / +62 851-0070-7600</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">08.00 – 21.00 WIB</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Scenic Clifftop Cafe &amp; Nature Resto</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">Besar (150+ orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">QR Order Spot Wisata, Multi-outlet Menu, POS Kasir Cloud</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Lokasi di atas bukit/tebing dengan kontur berundak. Pelayan sangat kelelahan jika harus antar menu fisik naik-turun tangga.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Kafe+Tebing+Taman+Botani+Sukorambi+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">7</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Kopi Cak Wang (Karimata)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Sumbersari (Karimata)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Jl. Karimata No.34, Gumuk Kerikil, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 812-3488-0318</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">09.00 – 00.00 WIB</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Traditional-Modern Coffeehouse Populer</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Besar (100+ orang)</Data></Cell>
    <Cell ss:StyleID="s72"><Data ss:Type="String">Prioritas Tinggi</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Kasir Layar Sentuh Cepat, Barcode Scanner, QRIS Otomatis</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Antrean pembayaran saat malam sangat panjang. Fitur fast-checkout dan self-order di meja akan mengurai antrean kasir.</Data></Cell>
    <Cell ss:StyleID="s67" ss:HRef="https://www.google.com/maps/search/?api=1&amp;query=Kopi+Cak+Wang+Karimata+Jember"><Data
      ss:Type="String">Buka di Google Maps</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s69"><Data ss:Type="Number">8</Data></Cell>
    <Cell ss:StyleID="s70"><Data ss:Type="String">Kopi Cak Wang (Mastrip 24 Jam)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Sumbersari (Mastrip)</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Jl. Mastrip No.53, Krajan Barat, Sumbersari, Jember 68121</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">+62 812-3488-0318</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">Buka 24 Jam</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">24/7 Kedai Kopi &amp; Kuliner Mahasiswa</Data></Cell>
    <Cell ss:StyleID="s69"><Data ss:Type="String">Besar (100+ orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Multi-branch Management (Pusat &amp; Cabang), Multi-user Role Kasir</Data></Cell>
    <Cell ss:StyleID="s71"><Data ss:Type="String">Memiliki 2 cabang utama di Jember. Owner butuh dashboard superadmin untuk memantau omzet kedua cabang dari satu HP.</Data></Cell>
