   <Row ss:AutoFitHeight="0" ss:Height="36">
    <Cell ss:StyleID="s63"><Data ss:Type="Number">1</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Bondowoso</Data></Cell>
    <Cell ss:StyleID="s64"><Data ss:Type="String">Anaga Coffee Space</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Dabasah (Dekat Alun-Alun)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Jl. Letnan Sudiono No.20, Kali Nangkaan, Dabasah, Bondowoso 68211</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">+62 821-1172-9261</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">09.30 – 23.00 WIB</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Industrial Modern Cafe &amp; Space Nugas</Data></Cell>
    <Cell ss:StyleID="s63"><Data ss:Type="String">Sedang-Besar (80 orang)</Data></Cell>
    <Cell ss:StyleID="s66"><Data ss:Type="String">Prioritas Sangat Tinggi</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">QR Table Ordering, Split Bill Mahasiswa/Pelajar, QRIS Dinamis</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Titik kumpul utama anak muda Bondowoso. Sering penuh saat sore-malam. QR ordering mencegah antrean kasir.</Data></Cell>
