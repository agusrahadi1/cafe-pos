    <Cell ss:StyleID="s63"><Data ss:Type="String">10.00 – 23.00 WIB (Sabtu s/d 23.45)</Data></Cell>
    <Cell ss:StyleID="s65"><Data ss:Type="String">Family Resto, Live Music &amp; Cafe Luas</Data></Cell>
